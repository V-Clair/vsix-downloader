# 跨语言基础格式约定；语言细节由各文档与工具（clang-format / dotnet format / ruff）负责
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_size = 2
# Markdown 行尾两个空格表示换行，不能裁剪
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{c,h,cpp,hpp}]
indent_size = 4
max_line_length = 100

[*.{cs,csproj,props,targets}]
indent_size = 4
max_line_length = 120

[*.py]
indent_size = 4
max_line_length = 100

[*.{sln,slnx}]
indent_size = 4
end_of_line = crlf

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
