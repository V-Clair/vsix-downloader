# 默认：自动识别文本，统一 LF
* text=auto eol=lf

# ---- 强制 LF ----
*.py       text eol=lf
*.md       text eol=lf
*.sh       text eol=lf

# ---- 强制 CRLF（Windows 工具链与 Visual Studio 约定）----
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ---- 二进制：禁止换行符转换与文本 diff ----
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.vsix     binary

# ---- 语言统计 ----
*.md       linguist-documentation
